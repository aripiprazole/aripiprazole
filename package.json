{
	"name": "aripiprazole",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.17.0",
	"scripts": {
		"dev": "bun run --bun vite dev",
		"build": "bun run --bun vite build",
		"preview": "bun run --bun vite preview",
		"test": "bun test",
		"sync": "bun run --bun svelte-kit sync",
		"precheck": "pnpm sync",
		"check": "bun run --bun svelte-check --tsconfig ./tsconfig.json"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/bun": "^1.3.14",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.3",
		"typescript": "^6.0.3",
		"vite": "^8.1.5"
	},
	"dependencies": {
		"zod": "^4.4.3"
	}
}
