# Public client configuration. Leave empty for a same-origin server build.
PUBLIC_API_BASE_URL=

# Local provider fixtures. `pnpm dev:stub` sets this automatically.
PORTFOLIO_API_STUB=0

# Provider identities.
GITHUB_USERNAME=aripiprazole
CHESS_USERNAME=iogabx
WAKATIME_USERNAME=aripiprazole
WYNNCRAFT_USERNAME=Brexpiprazole

# Server-only credentials. Never prefix these with PUBLIC_.
GITHUB_TOKEN=
WAKATIME_API_KEY=
# Instead of an API key, WakaTime can use a revocable public share JSON URL.
WAKATIME_SHARE_URL=
OPENAI_ADMIN_KEY=
# Required with OPENAI_ADMIN_KEY: only this project's aggregate is published.
OPENAI_PROJECT_ID=
# Optional Wynncraft Public Mode token; guest access also works.
WYNNCRAFT_TOKEN=
